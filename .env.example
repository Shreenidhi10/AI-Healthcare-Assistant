# ==============================================================================
# Environment Configuration for AI-Powered Healthcare Communication Assistant
# ==============================================================================

# --- Server & General Settings ---
APP_NAME="Healthcare AI Assistant Master API"
ENV=development
PORT=8000
LOG_LEVEL=INFO

# --- Frontend / CORS ---
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# --- Database Configurations ---
# SQLite default (zero-setup development)
DATABASE_URL=sqlite:///./health_explained.db
DASHBOARD_DATABASE_URL=sqlite:///./dashboard.db
# PostgreSQL for production deployment (uncomment if using Postgres):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/health_explained

# --- Authentication & JWT Security ---
# Generate strong random keys using: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=YOUR_SUPER_SECRET_JWT_KEY_HERE_MIN_64_CHARS
REFRESH_SECRET_KEY=YOUR_SUPER_SECRET_REFRESH_KEY_HERE_MIN_64_CHARS
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Vector Database & Embeddings (Pinecone & BGE-M3) ---
PINECONE_API_KEY=YOUR_PINECONE_API_KEY
PINECONE_INDEX_NAME=infosys-healthcare-ai-assistant
PINECONE_ENVIRONMENT=us-east-1

# --- Local & Cloud LLM Settings (Ollama & Gemma 3) ---
OLLAMA_MODEL=gemma3:1b
OLLAMA_HOST=http://127.0.0.1:11434

# --- Cloud AI Speech & Inference APIs ---
# Groq API for ultra-fast Whisper speech-to-text (STT)
GROQ_API_KEY=YOUR_GROQ_API_KEY
# Google Gemini API for cloud multilingual reasoning & fallback
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# --- Storage Paths & Limits ---
UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs
LOG_DIR=./logs
MODELS_DIR=./models
MAX_FILE_SIZE_MB=25
MAX_PDF_PAGES=30

# --- OCR & Preprocessing Configurations ---
OCR_LANGUAGE=en
OCR_USE_ANGLE_CLS=True
OCR_USE_GPU=False
OCR_MIN_CONFIDENCE=0.50
OCR_ALLOW_STUB_ENGINE=True

# --- NLP & Clinical Entity Extraction (BioClinicalBERT) ---
NLP_MODEL_NAME=emilyalsentzer/Bio_ClinicalBERT
NLP_MAX_INPUT_CHARS=4000
REVIEW_CONFIDENCE_THRESHOLD=0.70
